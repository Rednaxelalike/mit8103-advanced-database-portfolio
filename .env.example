# Copy this file to .env and fill in the real values.
# .env is git-ignored: never commit passwords or the Atlas connection string.

# Local PostgreSQL (Portfolios 1, 2, 3 and 5)
# Standard libpq variable names, so psql and pg_* tools pick them up when exported.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=change-me
PGDATABASE=proclus

# Portfolio 5 streaming replica (same laptop, second instance)
PGREPLICA_PORT=5433

# MongoDB Atlas free cluster (Portfolio 4, and cloud evidence for Portfolio 5)
# Atlas > Connect > Drivers shows this string; the database name goes after the host.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>.mongodb.net/proclus
