        <mxCell id="title" value="&lt;b&gt;Proclus wallet database&lt;/b&gt;: entity-relationship diagram (crow's-foot notation), PostgreSQL 18, built by sql/01_schema.sql" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1100" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="audit_note" value="No foreign keys by design: entity_id points at a different table per entity_type, and audit rows must outlive the rows they describe." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#666666;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="648" width="370" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; primary key &amp;nbsp; &lt;b&gt;FK&lt;/b&gt; foreign key &amp;nbsp; &lt;b&gt;UQ&lt;/b&gt; single-column UNIQUE (candidate key) &amp;nbsp; &lt;b&gt;U1, U2&lt;/b&gt; columns of a composite UNIQUE candidate key in that table &amp;nbsp; &lt;font color=&quot;#999999&quot;&gt;null&lt;/font&gt; nullable column, all others NOT NULL&lt;br&gt;Crow's foot at the child end: &lt;b&gt;o&amp;lt;&lt;/b&gt; zero or many. At the parent end: &lt;b&gt;||&lt;/b&gt; exactly one (mandatory FK), &lt;b&gt;o|&lt;/b&gt; zero or one (nullable FK). Edge labels give the relationship and its ON DELETE rule.&lt;br&gt;wallets.balance is a deliberate denormalisation: it equals completed credits minus completed debits in transactions. Money is NUMERIC(14,2), times are TIMESTAMPTZ, status columns are CHECK-constrained sets." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#fafafa;strokeColor=#bbbbbb;" vertex="1" parent="1">
          <mxGeometry x="40" y="1030" width="1510" height="92" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
